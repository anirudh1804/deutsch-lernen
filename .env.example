# Supabase
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side only (for scripts like scripts/reset-vocab.mjs). Keep private.
# Get it at: Supabase Dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google Cloud TTS (for Edge Function)
GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key

# Optional: Analytics
VITE_GA_MEASUREMENT_ID=